# Database
DATABASE_URL=postgresql://mcpaper_user:PASSWORD@localhost:5432/mcpaper_db

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth / Authentication
NEXTAUTH_SECRET=generate-secure-secret-here
NEXTAUTH_URL=https://mcpaper.distri-smart.com

# Stripe (to be filled in admin panel, but prepare env vars)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mcpaper-demo.de

# App
NEXT_PUBLIC_APP_URL=https://mcpaper.distri-smart.com
NEXT_PUBLIC_APP_NAME=McPaper
